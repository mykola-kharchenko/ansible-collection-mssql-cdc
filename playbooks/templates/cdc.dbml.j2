{#-
Render the CDC-captured tables of one database as DBML.

Inputs (vars expected on the task):
  cdc        — the value of ansible_facts.mssql_cdc (a dict)
  host_label — optional human-friendly host string for the header comment

The template assumes cdc_facts was invoked with gather_schema_details=true so
each captured table carries a `schema` block with column types, PKs, FKs and
comments. If `schema` is missing it falls back to bare column names with
varchar typing (still valid DBML, just less detailed).
-#}
{%- macro column_settings(col) -%}
{%- set bits = [] -%}
{%- if col.is_pk %}{%- set _ = bits.append('pk') %}{%- endif -%}
{%- if col.is_identity %}{%- set _ = bits.append('increment') %}{%- endif -%}
{%- if not col.nullable and not col.is_pk %}{%- set _ = bits.append('not null') %}{%- endif -%}
{%- if col.ref %}{%- set _ = bits.append('ref: > ' + col.ref) %}{%- endif -%}
{%- if bits %} [{{ bits | join(', ') }}]{%- endif -%}
{%- endmacro -%}
// Generated by mykola_kharchenko.mssql_cdc.cdc_facts → cdc.dbml.j2
// Database: {{ cdc.database }}{% if host_label is defined %} @ {{ host_label }}{% endif %}

{% if not cdc.cdc_enabled -%}
// Database-level CDC is not enabled. No capture instances to document.
{%- elif cdc.tables | length == 0 -%}
// Database-level CDC is enabled but no tables are captured.
{%- else %}
{%- for tbl in cdc.tables %}

Table {{ tbl.source_table }} {
{%- if tbl.schema is defined and tbl.schema %}
{%- for col in tbl.schema.columns %}
  {{ col.name }} {{ col.type }}{{ column_settings(col) }}
{%- endfor %}
{%- else %}
{%- for col_name in tbl.source_columns %}
  {{ col_name }} varchar
{%- endfor %}
{%- endif %}

  Note: '''
    CDC capture instance: {{ tbl.capture_instance }}
    Net changes:          {{ 'yes' if tbl.supports_net_changes else 'no' }}
    Role:                 {{ tbl.role_name or 'none' }}
    Captured columns:     {% if tbl.captures_all_columns %}all source columns{% else %}{{ tbl.columns | join(', ') }}{% endif %}
{%- if tbl.schema is defined and tbl.schema and tbl.schema.note %}
    Source table note:    {{ tbl.schema.note }}
{%- endif %}
  '''
}
{%- endfor %}
{%- endif %}
